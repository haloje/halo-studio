{
  "appId": "je.halo.studio",
  "appName": "halo.je Studio",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "*.supabase.co"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#121110"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#121110",
      "showSpinner": false,
      "launchFadeOutDuration": 250
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true,
      "statsUrl": "",
      "channelUrl": "",
      "updateUrl": ""
    }
  }
}